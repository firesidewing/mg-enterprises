---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import BuybackCalculator from '../components/BuybackCalculator.astro';
import LifecycleCurve from '../components/LifecycleCurve.astro';
import {
  COMMERCIAL_OUTCOMES,
  INDUSTRIES_SERVED,
  SPECTRALINK_CONTRACTS,
  SUPPORTED_MANUFACTURERS,
} from '../data/catalog';
---

<BaseLayout
  title="MG Enterprises — Canadian Enterprise Mobility Lifecycle Solutions"
  description="Your technology still has value. MG Enterprises helps Canadian organizations and channel partners recover capital through enterprise device buyback, 3/6/12-month Spectralink maintenance contracts, and technology refresh programs."
  activeNav="home"
>
  <!-- Opening Asymmetric Limestone & Brass Canvas -->
  <section class="relative overflow-hidden bg-stone pt-4 pb-6 lg:pt-5 lg:pb-8">
    <!-- Subtle architectural 55° slash geometry recessed into the limestone ground -->
    <div
      class="pointer-events-none absolute -bottom-10 -left-10 hidden w-[360px] text-navy/[0.06] lg:block"
      aria-hidden="true"
    >
      <BrandMark variant="watermark" theme="light" class="h-auto w-full" />
    </div>

    <div class="relative mx-auto max-w-[1320px] px-5 sm:px-6 lg:px-12">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="min-w-0 lg:col-span-6">
          <h1 class="font-display text-[38px] leading-[1.01] font-semibold tracking-[-0.03em] text-navy sm:text-[54px] xl:text-[62px]">
            Your technology still has value. We help you unlock it.
          </h1>
          <p class="mt-4 max-w-[56ch] text-[17.5px] leading-[1.5] font-medium text-navy sm:text-[19.5px]">
            Recover capital<span class="mg-slash-divider" aria-hidden="true"></span>Extend equipment life<span class="mg-slash-divider" aria-hidden="true"></span>Modernize on your terms.
          </p>
          <p class="mt-3 max-w-[58ch] text-[15.5px] leading-[1.6] text-ink-muted">
            Enterprise communication systems are essential to everyday operations — yet replacing an entire mobile fleet is a major capital hurdle. MG Enterprises helps Canadian organizations turn aging iOS, Android, Spectralink, Zebra, and Cisco devices into recovered capital while extending existing systems through flexible maintenance.
          </p>

          <div class="mt-6 flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-5">
            <a
              href="/assessment"
              class="inline-flex w-full items-center justify-center gap-2.5 rounded-[3px] bg-navy px-5 py-3.5 text-[15px] font-semibold text-stone transition-colors hover:bg-navy-surface sm:w-auto sm:px-6 sm:py-3.5"
            >
              <span>Request Equipment Recovery Assessment</span>
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3.5 8h9m0 0-3.5-3.5M12.5 8 9 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a
              href="/partners"
              class="inline-flex items-center gap-1.5 border-b-[1.5px] border-brass pb-1 text-[15px] font-semibold text-navy transition-colors hover:text-brass-deep"
            >
              Channel Partner Programs
            </a>
          </div>
        </div>

        <div class="min-w-0 lg:col-span-6">
          <BuybackCalculator mode="compact" idPrefix="hero-calc" />
        </div>
      </div>
    </div>
  </section>

  <!-- Full-Bleed Midnight-Navy Spectralink 3 / 6 / 12-Month Continuity Horizon -->
  <section class="dark-surface relative overflow-hidden bg-navy text-ink-on-dark" aria-labelledby="spectralink-horizon-heading">
    <div
      class="pointer-events-none absolute top-1/2 -right-8 w-[300px] -translate-y-1/2 text-brass-light/[0.09]"
      aria-hidden="true"
    >
      <BrandMark variant="watermark" theme="dark" class="h-auto w-full" />
    </div>

    <div class="relative mx-auto max-w-[1320px] px-6 py-6 lg:px-12 lg:py-7">
      <div class="grid gap-5 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-4">
          <h2 id="spectralink-horizon-heading" class="font-display text-2xl font-semibold tracking-[-0.02em] text-ink-on-dark">
            Customized Spectralink Contracts
          </h2>
          <p class="mt-1 text-[14px] leading-snug text-muted-on-dark">
            Short-term extended warranty and maintenance aligned to your refresh timeline.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-3 lg:col-span-8">
          {SPECTRALINK_CONTRACTS.map((contract) => (
            <a
              href="/maintenance"
              class="group block rounded-[4px] bg-navy-surface/90 px-4 py-3.5 transition-colors hover:bg-navy-elevated"
            >
              <div class="flex items-baseline justify-between gap-2">
                <span class="font-display text-[20px] font-bold tracking-[-0.02em] text-brass-light tabular">
                  {contract.term}
                </span>
                <svg class="h-4 w-4 text-brass-light/80 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3.5 8h9m0 0-3.5-3.5M12.5 8 9 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <p class="mt-0.5 text-[14.5px] font-semibold text-ink-on-dark">{contract.title}</p>
              <p class="mt-0.5 text-[13px] leading-snug text-muted-on-dark">{contract.idealFor}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Three Commercial Outcomes — Asymmetric Editorial Ledger -->
  <section class="bg-stone py-20 lg:py-28" aria-labelledby="outcomes-heading">
    <div class="mx-auto max-w-[1320px] px-6 lg:px-12">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2
            id="outcomes-heading"
            class="font-display text-3xl leading-[1.08] font-semibold tracking-[-0.025em] text-navy sm:text-[40px]"
          >
            Protect your investment. Move forward with confidence.
          </h2>
          <p class="mt-5 text-[16px] leading-relaxed text-ink-muted">
            More than repair or recycling — MG Enterprises reframes aging hardware as a financial and operational strategy for IT, procurement, and business leadership across Canada.
          </p>
        </div>

        <div class="divide-y divide-stone-deep lg:col-span-8 lg:pl-8">
          {COMMERCIAL_OUTCOMES.map((outcome) => (
            <div class="grid gap-4 py-7 first:pt-0 last:pb-0 sm:grid-cols-12 sm:items-baseline">
              <h3 class="font-display text-2xl font-semibold tracking-[-0.02em] text-navy sm:col-span-4">
                {outcome.title}
              </h3>
              <div class="sm:col-span-8">
                <p class="text-[16px] leading-relaxed text-ink-muted">{outcome.summary}</p>
                <a
                  href={outcome.href}
                  class="mt-3 inline-flex items-center gap-1.5 text-[14.5px] font-semibold text-navy underline decoration-brass hover:text-brass-deep"
                >
                  {outcome.cta}
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Four Solutions — Buyback Prominent Lead + Three Supporting Disciplines -->
  <section class="bg-stone-subtle py-20 lg:py-28" aria-labelledby="solutions-heading">
    <div class="mx-auto max-w-[1320px] px-6 lg:px-12">
      <div class="max-w-2xl">
        <h2
          id="solutions-heading"
          class="font-display text-3xl leading-[1.08] font-semibold tracking-[-0.025em] text-navy sm:text-[42px]"
        >
          Enterprise Mobility Lifecycle Solutions
        </h2>
        <p class="mt-4 text-[16.5px] leading-relaxed text-ink-muted">
          Four integrated programs engineered to recover residual value first, keep proven fleets productive, and reduce the capital barrier to modernization.
        </p>
      </div>

      <!-- Featured Lead: Enterprise Device Buyback -->
      <div class="mt-12 grid gap-8 rounded-[6px] bg-stone-well p-7 sm:p-10 lg:grid-cols-12 lg:items-center">
        <div class="min-w-0 lg:col-span-7">
          <div class="flex flex-wrap items-baseline gap-3">
            <h3 class="font-display text-2xl font-semibold tracking-[-0.02em] text-navy sm:text-[34px]">
              Enterprise Device Buyback
            </h3>
            <span class="rounded-[2px] bg-navy px-2.5 py-1 text-[11.5px] font-semibold tracking-[0.06em] text-brass-light uppercase">
              Flagship Program
            </span>
          </div>
          <p class="mt-3 max-w-[58ch] text-[16.5px] leading-relaxed text-ink-muted">
            Your retired mobile devices and communications infrastructure may still hold substantial financial value. We evaluate eligible iOS, Android, Spectralink, Cisco, Zebra, and legacy enterprise fleets and deliver competitive purchase offers that turn decommissioned hardware into recovered capital.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-4">
            <a
              href="/buyback"
              class="inline-flex items-center gap-2 rounded-[3px] bg-navy px-5 py-3 text-[14.5px] font-semibold text-stone transition-colors hover:bg-navy-surface"
            >
              Explore Buyback Program
            </a>
            <a
              href="/buyback#calculator"
              class="text-[14.5px] font-semibold text-navy underline decoration-brass hover:text-brass-deep"
            >
              Open Full Multi-Fleet Calculator
            </a>
          </div>
        </div>

        <ul class="space-y-3 border-t border-stone-deep pt-6 text-[15px] text-navy lg:col-span-5 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-4 w-4 shrink-0 text-brass-deep" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>Buyback assessments for eligible enterprise handsets and infrastructure</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-4 w-4 shrink-0 text-brass-deep" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>Competitive offers based on model, quantity, age, condition, and market demand</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-4 w-4 shrink-0 text-brass-deep" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>Coordinated bulk fleet retirement for iOS, Android, and wireless fleets</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-4 w-4 shrink-0 text-brass-deep" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>Reuse and responsible recycling options for non-recoverable units</span>
          </li>
        </ul>
      </div>

      <!-- Remaining Three Solutions — Varied Editorial Columns -->
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        <article class="flex flex-col justify-between rounded-[6px] bg-stone p-7">
          <div>
            <h3 class="font-display text-[23px] font-semibold tracking-[-0.02em] text-navy">
              Equipment Maintenance &amp; Lifecycle Extension
            </h3>
            <p class="mt-3 text-[15.5px] leading-relaxed text-ink-muted">
              Not every system needs immediate replacement. Keep essential wireless fleets operational with customized 3-, 6-, and 12-month Spectralink agreements, depot repair, spare sourcing, and eligible end-of-life support.
            </p>
          </div>
          <a
            href="/maintenance"
            class="mt-6 inline-flex items-center gap-1.5 text-[14.5px] font-semibold text-navy underline decoration-brass hover:text-brass-deep"
          >
            View Maintenance Programs
          </a>
        </article>

        <article class="flex flex-col justify-between rounded-[6px] bg-stone p-7">
          <div>
            <h3 class="font-display text-[23px] font-semibold tracking-[-0.02em] text-navy">
              Technology Refresh &amp; Transition Programs
            </h3>
            <p class="mt-3 text-[15.5px] leading-relaxed text-ink-muted">
              Replacing hundreds or thousands of handsets is a major capital project. We assess your fleet early, estimate recovery value, coordinate staged retirement, and support phased modernization.
            </p>
          </div>
          <a
            href="/maintenance#refresh"
            class="mt-6 inline-flex items-center gap-1.5 text-[14.5px] font-semibold text-navy underline decoration-brass hover:text-brass-deep"
          >
            See Phased Refresh Workflow
          </a>
        </article>

        <article class="flex flex-col justify-between rounded-[6px] bg-stone p-7">
          <div>
            <h3 class="font-display text-[23px] font-semibold tracking-[-0.02em] text-navy">
              Responsible Technology Recovery
            </h3>
            <p class="mt-3 text-[15.5px] leading-relaxed text-ink-muted">
              Retired enterprise communications gear should not default to electronic waste. We prioritize reuse and refurbishment wherever practical, backed by responsible recycling when equipment cannot be recovered.
            </p>
          </div>
          <a
            href="/buyback#recovery"
            class="mt-6 inline-flex items-center gap-1.5 text-[14.5px] font-semibold text-navy underline decoration-brass hover:text-brass-deep"
          >
            Read Recovery Commitment
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Signature Interactive 5-Year Residual Value & Spectralink Bridge Timeline -->
  <LifecycleCurve />

  <!-- Spectralink Business Case + Channel Partner Wedge -->
  <section class="bg-stone py-20 lg:py-28" aria-labelledby="business-case-heading">
    <div class="mx-auto max-w-[1320px] px-6 lg:px-12">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-stretch">
        <!-- Illustrative Customer Business Case -->
        <div class="flex flex-col justify-between rounded-[6px] bg-stone-well p-7 sm:p-10 lg:col-span-6">
          <div>
            <h2
              id="business-case-heading"
              class="font-display text-3xl leading-[1.08] font-semibold tracking-[-0.025em] text-navy sm:text-[36px]"
            >
              The Spectralink upgrade math changes when buyback enters early.
            </h2>
            <p class="mt-4 text-[16px] leading-relaxed text-ink-muted">
              Introducing an equipment recovery assessment before purchasing replacement handsets gives finance and IT leadership an immediate funding lever.
            </p>

            <dl class="mt-8 divide-y divide-stone-deep">
              <div class="flex items-baseline justify-between gap-4 py-4">
                <dt class="text-[15.5px] font-medium text-ink-muted">New device investment</dt>
                <dd class="font-display tabular text-2xl font-semibold text-navy">$200,000</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 py-4">
                <dt class="text-[15.5px] font-medium text-ink-muted">Potential fleet buyback</dt>
                <dd class="font-display tabular text-2xl font-semibold text-brass-deep">&minus; $25,000</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 pt-5">
                <dt class="text-[16.5px] font-bold text-navy">Effective upgrade cost</dt>
                <dd class="font-display tabular text-4xl font-bold tracking-[-0.03em] text-navy">$175,000</dd>
              </div>
            </dl>
          </div>

          <p class="mt-6 text-[13px] leading-relaxed text-ink-muted">
            Illustrative 12.5% capital recovery example — not an actual buyback quote. Actual recovery depends on fleet models, volume, age, condition, and eligibility.
          </p>
        </div>

        <!-- Channel Partner Architectural Panel -->
        <div class="dark-surface relative flex flex-col justify-between overflow-hidden rounded-[6px] bg-navy p-7 text-ink-on-dark sm:p-10 lg:col-span-6">
          <div
            class="pointer-events-none absolute -right-10 -bottom-8 w-[260px] text-brass-light/[0.06]"
            aria-hidden="true"
          >
            <BrandMark variant="watermark" theme="dark" class="h-auto w-full" />
          </div>

          <div class="relative">
            <h2 class="font-display text-3xl leading-[1.08] font-semibold tracking-[-0.025em] text-ink-on-dark sm:text-[36px]">
              Don't just sell the replacement. Help customers recover value from what they're replacing.
            </h2>
            <p class="mt-4 text-[16px] leading-relaxed text-muted-on-dark">
              For Canadian resellers and systems integrators, introducing MG Enterprises early in a hardware proposal reopens delayed refresh conversations and differentiates beyond unit pricing alone.
            </p>

            <ul class="mt-7 space-y-3 text-[15px] text-ink-on-dark/90">
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-4 w-4 shrink-0 text-brass-light" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>Reopen delayed Spectralink and enterprise mobile refresh discussions</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-4 w-4 shrink-0 text-brass-light" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>Bundle equipment recovery directly inside new hardware proposals</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-4 w-4 shrink-0 text-brass-light" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>Expand account relationships with 3-, 6-, and 12-month maintenance options</span>
              </li>
            </ul>
          </div>

          <div class="relative mt-8 flex flex-wrap items-center gap-4">
            <a
              href="/partners"
              class="inline-flex items-center gap-2 rounded-[3px] bg-brass-light px-6 py-3.5 text-[15px] font-semibold text-navy transition-colors hover:bg-brass-pale"
            >
              Explore Channel Partner Programs
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Supported Manufacturers & Industries Served -->
  <section class="bg-stone-subtle py-20 lg:py-24" aria-labelledby="coverage-heading">
    <div class="mx-auto max-w-[1320px] px-6 lg:px-12">
      <div class="grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2
            id="coverage-heading"
            class="font-display text-3xl leading-[1.1] font-semibold tracking-[-0.025em] text-navy sm:text-[36px]"
          >
            Technologies we support
          </h2>
          <p class="mt-4 text-[15.5px] leading-relaxed text-ink-muted">
            Subject to model eligibility and service availability, our buyback and lifecycle programs span leading enterprise wireless and mobile manufacturers across Canada.
          </p>

          <ul class="mt-7 flex flex-wrap gap-2.5">
            {SUPPORTED_MANUFACTURERS.map((oem) => (
              <li class="rounded-[3px] bg-stone px-4 py-2.5 font-display text-[15.5px] font-semibold text-navy">
                {oem}
              </li>
            ))}
            <li class="rounded-[3px] bg-stone px-4 py-2.5 font-display text-[15.5px] font-semibold text-navy">
              Android Enterprise
            </li>
          </ul>
        </div>

        <div class="lg:col-span-7">
          <h2 class="font-display text-3xl leading-[1.1] font-semibold tracking-[-0.025em] text-navy sm:text-[36px]">
            Who we serve
          </h2>
          <div class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2">
            {INDUSTRIES_SERVED.map((ind) => (
              <div class="border-t border-stone-deep pt-4">
                <h3 class="font-display text-[19px] font-semibold text-navy">{ind.name}</h3>
                <p class="mt-1.5 text-[14.5px] leading-relaxed text-ink-muted">{ind.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Grounded Closing Conversion Band -->
  <section class="bg-stone py-20 lg:py-24" aria-labelledby="closing-cta-heading">
    <div class="mx-auto max-w-[1320px] px-6 lg:px-12">
      <div class="grid gap-8 rounded-[6px] bg-stone-well p-8 sm:p-12 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-8">
          <div class="mb-5">
            <BrandMark variant="monogram" theme="light" class="h-10 w-auto" />
          </div>
          <h2
            id="closing-cta-heading"
            class="font-display text-3xl leading-[1.08] font-semibold tracking-[-0.025em] text-navy sm:text-[40px]"
          >
            Get more from your existing technology.
          </h2>
          <p class="mt-4 max-w-[60ch] text-[16.5px] leading-relaxed text-ink-muted">
            Whether you are maintaining an aging Spectralink fleet, planning an enterprise-wide iOS or Android upgrade, or retiring legacy communications equipment, we will help identify the most economical path forward.
          </p>
        </div>
        <div class="flex flex-col gap-3 lg:col-span-4 lg:items-end">
          <a
            href="/assessment"
            class="inline-flex w-full items-center justify-center gap-2 rounded-[3px] bg-navy px-6 py-4 text-[15.5px] font-semibold text-stone transition-colors hover:bg-navy-surface lg:w-auto"
          >
            Request an Equipment Recovery Assessment
          </a>
          <a
            href="/buyback#calculator"
            class="inline-flex w-full items-center justify-center rounded-[3px] bg-stone px-6 py-3.5 text-[14.5px] font-semibold text-navy transition-colors hover:bg-alabaster lg:w-auto"
          >
            Run Rough Estimate Calculator
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
