---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuybackCalculator from '../components/BuybackCalculator.astro';
import BrandMark from '../components/BrandMark.astro';
import { SUPPORTED_MANUFACTURERS } from '../data/catalog';
---

<BaseLayout
  title="Enterprise Device Buyback & Rough Estimate Calculator — MG Enterprises"
  description="Estimate potential buyback recovery for retired iOS, Android, Spectralink, Cisco, Zebra, and enterprise communications fleets across Canada."
  activeNav="buyback"
>
  <section class="bg-stone pt-12 pb-16 lg:pt-16 lg:pb-20">
    <div class="mx-auto max-w-[1320px] px-6 lg:px-12">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <h1 class="font-display text-4xl leading-[1.03] font-semibold tracking-[-0.03em] text-navy sm:text-[54px]">
            Turn retired enterprise devices into recovered capital.
          </h1>
          <p class="mt-5 max-w-[60ch] text-[17.5px] leading-relaxed text-ink-muted">
            When your organization upgrades aging iOS, Android, Spectralink, Cisco, or Zebra fleets, decommissioned hardware does not have to sit in storage or leave money on the table. MG Enterprises evaluates eligible handsets and communications infrastructure and delivers competitive purchase offers.
          </p>
        </div>
        <div class="lg:col-span-5 lg:text-right">
          <a
            href="/assessment"
            class="inline-flex items-center gap-2 rounded-[3px] bg-navy px-6 py-4 text-[15px] font-semibold text-stone transition-colors hover:bg-navy-surface"
          >
            Request Formal Fleet Valuation
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Full Interactive Multi-Fleet Rough Estimate Calculator -->
  <section id="calculator" class="scroll-mt-24 bg-stone-subtle py-16 lg:py-22" aria-labelledby="calc-heading">
    <div class="mx-auto max-w-[1320px] px-6 lg:px-12">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-4">
          <h2 id="calc-heading" class="font-display text-3xl leading-[1.08] font-semibold tracking-[-0.025em] text-navy">
            Rough Buyback Estimate Calculator
          </h2>
          <p class="mt-4 text-[15.5px] leading-relaxed text-ink-muted">
            Tell us how many devices you plan to retire, the device family or model, and how long your organization has owned them to preview an illustrative recovery range.
          </p>

          <div class="mt-8 space-y-5 border-t border-stone-deep pt-6">
            <div>
              <h3 class="font-display text-lg font-semibold text-navy">What determines final value</h3>
              <p class="mt-1.5 text-[14.5px] leading-relaxed text-ink-muted">
                Formal purchase offers are prepared from your device list based on exact model numbers, total fleet volume, ownership age, physical condition, accessories, and current secondary market demand.
              </p>
            </div>
            <div>
              <h3 class="font-display text-lg font-semibold text-navy">Mixed-fleet retirements</h3>
              <p class="mt-1.5 text-[14.5px] leading-relaxed text-ink-muted">
                Use <strong>+ Add to Fleet Docket</strong> inside the calculator to combine iPhones, Android devices, Spectralink handsets, Zebra scanners, and Cisco phones into a single assessment submission.
              </p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-8">
          <BuybackCalculator mode="full" idPrefix="full-calc" />
        </div>
      </div>
    </div>
  </section>

  <!-- How Enterprise Device Buyback Works -->
  <section class="bg-stone py-20 lg:py-26" aria-labelledby="buyback-process-heading">
    <div class="mx-auto max-w-[1320px] px-6 lg:px-12">
      <h2 id="buyback-process-heading" class="font-display text-3xl leading-[1.08] font-semibold tracking-[-0.025em] text-navy sm:text-[40px]">
        From retired inventory to recovered capital
      </h2>

      <ol class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {[
          {
            step: '01',
            title: 'Share Your Fleet List',
            body: 'Send makes, models, approximate quantities, and ownership age — or start directly with our rough estimate docket above.',
          },
          {
            step: '02',
            title: 'Receive a Formal Offer',
            body: 'We evaluate model eligibility, condition, and market demand to provide a transparent, competitive purchase offer.',
          },
          {
            step: '03',
            title: 'Coordinate Fleet Retirement',
            body: 'Align device pickup and bulk intake with your phased rollout so active teams never lose communications coverage.',
          },
          {
            step: '04',
            title: 'Recover Capital & Reinvest',
            body: 'Apply recovered funds directly toward your next Spectralink, iOS, Android, or enterprise wireless modernization.',
          },
        ].map((item) => (
          <li class="rounded-[6px] bg-stone-well p-6">
            <span class="font-display tabular text-sm font-bold tracking-[0.12em] text-brass-deep">{item.step}</span>
            <h3 class="mt-3 font-display text-xl font-semibold text-navy">{item.title}</h3>
            <p class="mt-2 text-[14.5px] leading-relaxed text-ink-muted">{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Responsible Technology Recovery Band -->
  <section id="recovery" class="dark-surface relative scroll-mt-24 overflow-hidden bg-navy py-20 text-ink-on-dark lg:py-24" aria-labelledby="recovery-heading">
    <div
      class="pointer-events-none absolute -right-12 bottom-0 w-[380px] text-brass-light/[0.055]"
      aria-hidden="true"
    >
      <BrandMark variant="watermark" theme="dark" class="h-auto w-full" />
    </div>

    <div class="relative mx-auto max-w-[1320px] px-6 lg:px-12">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <h2 id="recovery-heading" class="font-display text-3xl leading-[1.08] font-semibold tracking-[-0.025em] text-ink-on-dark sm:text-[40px]">
            Responsible Technology Recovery
          </h2>
          <p class="mt-4 max-w-[60ch] text-[16.5px] leading-relaxed text-muted-on-dark">
            Retired enterprise technology should not automatically become electronic waste. MG Enterprises prioritizes equipment reuse and refurbishment wherever practical, keeping functional communications hardware productive while arranging responsible recycling options for equipment that cannot be recovered.
          </p>
        </div>

        <div class="rounded-[6px] bg-navy-surface p-7 lg:col-span-5">
          <h3 class="font-display text-xl font-semibold text-ink-on-dark">Eligible Enterprise Brands</h3>
          <p class="mt-3 text-[15px] leading-7 text-muted-on-dark">
            {SUPPORTED_MANUFACTURERS.join(' · ')} · Android Enterprise
          </p>
          <a
            href="/assessment?type=buyback"
            class="mt-6 inline-flex items-center gap-2 rounded-[3px] bg-brass-light px-5 py-3 text-[14.5px] font-semibold text-navy transition-colors hover:bg-brass-pale"
          >
            Start a Buyback Assessment
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
