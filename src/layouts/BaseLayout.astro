---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import { SUPPORTED_MANUFACTURERS } from '../data/catalog';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'home' | 'buyback' | 'calculator' | 'maintenance' | 'partners' | 'assessment';
}

const {
  title,
  description = 'MG Enterprises helps Canadian organizations and channel partners recover capital from aging mobile fleets, extend Spectralink hardware life with 3-, 6-, and 12-month contracts, and modernize affordably.',
  activeNav = 'home',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://mgenterprises.ca');

const navItems = [
  { id: 'buyback', label: 'Device Buyback', href: '/buyback' },
  { id: 'calculator', label: 'Calculator', href: '/buyback#calculator' },
  { id: 'maintenance', label: 'Spectralink Maintenance', href: '/maintenance' },
  { id: 'partners', label: 'Channel Partners', href: '/partners' },
] as const;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="theme-color" content="#0B1D35" />
  </head>
  <body class="bg-stone text-ink antialiased selection:bg-navy selection:text-brass-light">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-sm focus:bg-navy focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-stone"
    >
      Skip to main content
    </a>

    <header
      id="site-header"
      class="sticky top-0 z-40 border-b border-transparent bg-stone/95 transition-colors duration-200"
    >
      <div class="mx-auto flex h-20 max-w-[1320px] items-center justify-between gap-3 px-4 sm:px-6 lg:px-12">
        <a
          href="/"
          class="group inline-flex shrink-0 items-center focus-visible:outline-2"
          aria-label="MG Enterprises — Home"
        >
          <BrandMark variant="horizontal" theme="light" priority />
        </a>

        <nav aria-label="Primary navigation" class="hidden items-center gap-8 lg:flex xl:gap-10">
          {navItems.map((item) => {
            const isActive = activeNav === item.id;
            return (
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'relative py-1 text-[15px] font-medium transition-colors duration-150',
                  isActive
                    ? 'text-navy font-semibold after:absolute after:right-0 after:bottom-0 after:left-0 after:h-[2px] after:bg-brass'
                    : 'text-ink-muted hover:text-navy',
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="/assessment"
            class:list={[
              'hidden rounded-[3px] px-5 py-2.5 text-[14.5px] font-semibold transition-all duration-150 sm:inline-flex sm:items-center sm:gap-2',
              activeNav === 'assessment'
                ? 'bg-brass text-navy'
                : 'bg-navy text-stone hover:bg-navy-surface',
            ]}
          >
            Request Assessment
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 8h9m0 0-3.5-3.5M12.5 8 9 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>

          <button
            type="button"
            id="mobile-menu-btn"
            class="inline-flex h-10 w-10 items-center justify-center rounded-[3px] bg-stone-well text-navy transition-colors hover:bg-stone-deep lg:hidden"
            aria-expanded="false"
            aria-controls="mobile-nav-panel"
            aria-label="Toggle navigation menu"
          >
            <svg id="menu-icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <svg id="menu-icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>

      <div
        id="mobile-nav-panel"
        class="hidden border-t border-stone-deep bg-stone px-6 pt-4 pb-6 lg:hidden"
      >
        <nav aria-label="Mobile navigation" class="flex flex-col gap-1">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-[3px] px-3 py-3 text-base font-medium transition-colors',
                activeNav === item.id
                  ? 'bg-stone-well font-semibold text-navy'
                  : 'text-ink-muted hover:bg-stone-subtle hover:text-navy',
              ]}
            >
              {item.label}
            </a>
          ))}
          <a
            href="/assessment"
            class="mt-3 inline-flex items-center justify-center gap-2 rounded-[3px] bg-navy px-5 py-3.5 text-[15px] font-semibold text-stone"
          >
            Request Equipment Recovery Assessment
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="dark-surface relative overflow-hidden bg-navy text-ink-on-dark">
      <div
        class="pointer-events-none absolute -right-14 -bottom-10 w-[440px] text-brass-light/[0.06] lg:w-[560px]"
        aria-hidden="true"
      >
        <BrandMark variant="watermark" theme="dark" class="h-auto w-full" />
      </div>

      <div class="relative mx-auto max-w-[1320px] px-6 pt-16 pb-12 lg:px-12 lg:pt-20">
        <div class="grid gap-12 border-b border-white/10 pb-14 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-5">
            <a href="/" class="inline-block" aria-label="MG Enterprises — Home">
              <BrandMark variant="horizontal" theme="dark" />
            </a>
            <p class="mt-6 max-w-md text-[15.5px] leading-relaxed text-muted-on-dark">
              Canadian enterprise mobility lifecycle solutions. We help organizations recover capital from retired devices, extend Spectralink fleet life on flexible 3-, 6-, and 12-month terms, and modernize affordably.
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-4">
              <a
                href="/assessment"
                class="inline-flex items-center gap-2 rounded-[3px] bg-brass-light px-5 py-3 text-[14.5px] font-semibold text-navy transition-colors hover:bg-brass-pale"
              >
                Request Equipment Recovery Assessment
              </a>
            </div>
          </div>

          <div class="grid gap-8 sm:grid-cols-3 lg:col-span-7">
            <div>
              <h2 class="font-display text-sm font-semibold tracking-[0.08em] text-brass-light uppercase">
                Solutions
              </h2>
              <ul class="mt-4 space-y-2.5 text-[15px] text-muted-on-dark">
                <li><a href="/buyback" class="transition-colors hover:text-ink-on-dark">Enterprise Device Buyback</a></li>
                <li><a href="/buyback#calculator" class="transition-colors hover:text-ink-on-dark">Rough Estimate Calculator</a></li>
                <li><a href="/maintenance" class="transition-colors hover:text-ink-on-dark">Spectralink 3/6/12 Contracts</a></li>
                <li><a href="/maintenance#refresh" class="transition-colors hover:text-ink-on-dark">Technology Refresh Programs</a></li>
                <li><a href="/buyback#recovery" class="transition-colors hover:text-ink-on-dark">Responsible Recovery</a></li>
              </ul>
            </div>

            <div>
              <h2 class="font-display text-sm font-semibold tracking-[0.08em] text-brass-light uppercase">
                Work With Us
              </h2>
              <ul class="mt-4 space-y-2.5 text-[15px] text-muted-on-dark">
                <li><a href="/partners" class="transition-colors hover:text-ink-on-dark">Channel Partners &amp; Integrators</a></li>
                <li><a href="/assessment" class="transition-colors hover:text-ink-on-dark">Request Assessment</a></li>
                <li><a href="/assessment?type=maintenance" class="transition-colors hover:text-ink-on-dark">Spectralink Quote Inquiry</a></li>
                <li><a href="/assessment?audience=partner" class="transition-colors hover:text-ink-on-dark">Partner Deal Registration</a></li>
              </ul>
            </div>

            <div>
              <h2 class="font-display text-sm font-semibold tracking-[0.08em] text-brass-light uppercase">
                Supported OEMs
              </h2>
              <p class="mt-4 text-[14.5px] leading-7 text-muted-on-dark">
                {SUPPORTED_MANUFACTURERS.join(' · ')} · Android Enterprise
              </p>
              <p class="mt-4 text-[13px] leading-relaxed text-muted-on-dark/80">
                Serving Healthcare, Manufacturing, Warehousing &amp; Logistics, Retail, Enterprise IT, and Systems Integrators across Canada.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-8 flex flex-col gap-4 text-[13px] leading-relaxed text-muted-on-dark/80 md:flex-row md:items-center md:justify-between">
          <p class="max-w-3xl">
            All buyback offers, rough calculator estimates, maintenance services, support commitments, and recycling arrangements are illustrative and subject to model eligibility, device condition, market demand, and program terms.
          </p>
          <p class="shrink-0 text-muted-on-dark">
            &copy; {new Date().getFullYear()} MG Enterprises. Canada.
          </p>
        </div>
      </div>
    </footer>

    <script>
      const header = document.getElementById('site-header');
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobilePanel = document.getElementById('mobile-nav-panel');
      const openIcon = document.getElementById('menu-icon-open');
      const closeIcon = document.getElementById('menu-icon-close');

      const syncHeader = () => {
        if (!header) return;
        const scrolled = window.scrollY > 12;
        header.classList.toggle('border-stone-deep/80', scrolled);
        header.classList.toggle('border-transparent', !scrolled);
        header.classList.toggle('shadow-[0_6px_24px_rgba(11,29,53,0.06)]', scrolled);
      };
      syncHeader();
      window.addEventListener('scroll', syncHeader, { passive: true });

      menuBtn?.addEventListener('click', () => {
        const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!expanded));
        mobilePanel?.classList.toggle('hidden', expanded);
        openIcon?.classList.toggle('hidden', !expanded);
        closeIcon?.classList.toggle('hidden', expanded);
      });
    </script>
  </body>
</html>
